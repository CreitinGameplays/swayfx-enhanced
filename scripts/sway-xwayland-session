#!/bin/sh
set -eu

# Start SwayFX with Xwayland ready from launch, but keep Wayland as the native
# default. Xwayland should only be used by X11-only apps or explicit overrides.
export XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland,x11
export QT_QPA_PLATFORM='wayland;xcb'
export SDL_VIDEODRIVER=wayland,x11
export CLUTTER_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland

bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# 1. Force-kill any lingering background processes from previous dead sessions
# (This ensures you always start with a clean state and your real audio device)
killall -q pipewire wireplumber pipewire-pulse swaync 2>/dev/null || true

# 2. Define a cleanup function to fix the TTY for 'ly' and clean up processes
cleanup() {
    # Disable exit-on-error for the cleanup phase
    set +e

    # Kill the current session's background processes on logout
    killall -q pipewire wireplumber pipewire-pulse swaync 2>/dev/null || true
    killall -9 Xwayland

    # Give seatd/elogind a split-second to release the DRM/Input devices
    sleep 0.5
    # Restore terminal properties
    stty sane
    # Attempt to pull keyboard out of raw mode (suppress errors if run as non-root)
    kbd_mode -a 2>/dev/null || true
    # Completely reset the TTY
    reset
}

# 3. Trap the script exit so the cleanup ALWAYS runs, even if Sway crashes
trap cleanup EXIT INT TERM

# 4. Launch Sway wrapped inside a dedicated D-Bus session
if [ -x "$bindir/swayfx" ]; then
        dbus-run-session "$bindir/swayfx" "$@"
else
        dbus-run-session "$bindir/sway" "$@"
fi

