#!/bin/sh
set -eu

# Start SwayFX with Xwayland ready from launch, but keep Wayland as the native
# default. Xwayland should only be used by X11-only apps or explicit overrides.
export XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland,x11
export QT_QPA_PLATFORM='wayland;xcb'
export SDL_VIDEODRIVER=wayland,x11
export CLUTTER_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland

bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$bindir/swayfx" ]; then
	exec "$bindir/swayfx" "$@"
fi

exec "$bindir/sway" "$@"
